#!/usr/bin/env bash

# This file exists to automatically activate the devenv environment using
# direnv (see: https://direnv.net/) when entering this project directory.

# ---

# Optional environment to load when the direnv shell is activated
#
# NOTE: this is _not_ intended for application runtime environment. Rather, it
# allows you to define local development secrets, etc., isolated to this project
# instead of adding them to your global shell configuration such as `.zshrc`.
#
# Example:
# ```sh
# NODE_AUTH_TOKEN=ghp_••••••••••••••••••••••••••••••••••••
# ```
dotenv_if_exists .env.direnv

# Extra npm configuration that must not be committed, such as an additional
# private registry. The tracked `.npmrc` already carries the GitHub Packages auth
# line as a `${NODE_AUTH_TOKEN}` reference, which is all CI needs.
#
# Only npm reads this file: it merges the userconfig with the project `.npmrc`
# instead of replacing it. bun ignores NPM_CONFIG_USERCONFIG and reads only
# `~/.npmrc` plus the project file, so anything bun has to see belongs in the
# tracked `.npmrc` instead. The split is harmless here because bun resolves no
# private packages, and the token is read by the `npm publish` / `npm view` calls
# in `scripts/publish-fork.ts`.
#
# npm also gives the project `.npmrc` precedence over the userconfig, so this
# file can add settings but cannot override one the tracked file already sets.
npmrc_userconfig=$(find_up .npmrc.direnv || true)
if [[ -n $npmrc_userconfig ]]; then
  export NPM_CONFIG_USERCONFIG="$npmrc_userconfig"
fi

# Activate the devenv Nix environment, if available
#
# NOTE: devenv 2.1+ supports shell auto-activation natively, but it works a bit
# differently than direnv, so we support both and allow the user to opt-in based
# on their preference. See: https://devenv.sh/auto-activation/#comparison-with-direnv
#
# If both are setup in your shell, use the associated trust command to chose one
# or the other (`direnv allow` vs. `devenv allow`).
if has devenv; then
  source_url "https://raw.githubusercontent.com/cachix/devenv/refs/tags/v2.4.0/devenv/direnvrc" "sha256-p9dGsc/+ElCjLgTRoTFudKo+vcVNANKdvJMLReyteg8="
  use devenv
else
  echo "devenv: not found, skipping environment setup. See: https://devenv.sh/getting-started"
fi

# Optional user-owned overrides, sourced last so they win over everything above
#
# Unlike `.env.direnv`, which is read as a dotenv file, this is a full direnv
# file and can call the stdlib: `PATH_add`, `use`, `layout`, etc.
source_env_if_exists .envrc.local
